# Copie este arquivo para ".env" e troque os valores.
# O .env não vai para o GitHub (está no .gitignore).

# Seu usuário no Docker Hub (só precisa para publicar as imagens)
DOCKER_USUARIO=seu-usuario-do-dockerhub
VERSAO=latest

# Senha do usuário root do MySQL
MYSQL_ROOT_PASSWORD=troque-esta-senha

# Usuário que o site/servidor usa para acessar o banco "bovtrack"
MYSQL_USER=bovtrack
MYSQL_PASSWORD=bovtrack123

# Portas no seu computador (mude se alguma já estiver em uso)
DB_PORT=3306
PMA_PORT=8080
SITE_PORT=8000
API_PORT=3000

# Fuso horário das leituras
TZ=America/Sao_Paulo
